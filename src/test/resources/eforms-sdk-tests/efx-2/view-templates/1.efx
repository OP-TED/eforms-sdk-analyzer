// View 1
// File generated from metadata database
1 WITH BADND-Root[OPT-300-Procedure-Buyer is present] DISPLAY #{auxiliary|text|buyer}; // 1 Buyer
	1 WITH ND-ContractingParty DISPLAY #{auxiliary|text|buyer}; // 1.1 Buyer
		WITH ND-ContractingParty DISPLAY #{name|BT-500}: ${for text:$orgid in OPT-300-Procedure-Buyer, text:$orgname in BT-500-Organization-Company[OPT-200-Organization-Company == $orgid] return $orgname}; // Official name
		WITH BT-11-Procedure-Buyer DISPLAY #{name|BT-11}: #value; // Legal type of the buyer
		WITH BT-10-Procedure-Buyer DISPLAY #{name|BT-10}: #value; // Activity of the contracting authority
2 WITH ND-Root DISPLAY #{auxiliary|text|procedure}; // 2. Procedure
	1 WITH ND-ProcedureProcurementScope DISPLAY #{auxiliary|text|procedure}; // 2.1 Procedure
		WITH ND-ProcedureProcurementScope DISPLAY #{name|BT-21}: ${preferred-language-text(BT-21-Procedure)}; // Procedure Title
		WITH ND-ProcedureProcurementScope DISPLAY #{name|BT-24}: ${preferred-language-text(BT-24-Procedure)}; // Procedure Description
		WITH BT-22-Procedure DISPLAY #{name|BT-22}: $value; // Internal identifier
		1 WITH ND-ProcedureProcurementScope[(BT-23-Procedure is present) or (BT-531-Procedure is present) or (BT-262-Procedure is present) or (BT-263-Procedure is present)] DISPLAY #{auxiliary|text|purpose}; // 2.1.1 Purpose
			WITH BT-23-Procedure DISPLAY #{name|BT-23}: #value; // Nature of the contract
			WITH BT-531-Procedure DISPLAY #{name|BT-531}: #value; // Additional nature of the contract
			WITH BT-262-Procedure[BT-26(m)-Procedure == 'cpv'] DISPLAY #{name|BT-262} (${BT-26(m)-Procedure}): ${BT-262-Procedure} #{BT-262-Procedure}; // Main classification (CPV)
			WITH BT-262-Procedure[BT-26(m)-Procedure != 'cpv'] DISPLAY #{name|BT-262} (${BT-26(m)-Procedure}): ${BT-262-Procedure}; // Main classification (non-CPV)
			WITH BT-263-Procedure[BT-26(a)-Procedure == 'cpv'] DISPLAY #{name|BT-263} (${BT-26(a)-Procedure}): ${BT-263-Procedure} #{BT-263-Procedure}; // Additional classification (CPV)
			WITH BT-263-Procedure[BT-26(a)-Procedure != 'cpv'] DISPLAY #{name|BT-263} (${BT-26(a)-Procedure}): ${BT-263-Procedure}; // Additional classification (non-CPV)
		2 WITH ND-ProcedurePlacePerformance DISPLAY #{auxiliary|text|place-performance}; // 2.1.2 Place of performance
			WITH BT-5101(a)-Procedure DISPLAY #{name|BT-510}: ${BT-5101(a)-Procedure} ${BT-5101(b)-Procedure} ${BT-5101(c)-Procedure}; // Postal address
			WITH BT-5131-Procedure DISPLAY #{name|BT-5131}: $value; // Town
			WITH BT-5121-Procedure DISPLAY #{name|BT-5121}: $value; // Post Code
			WITH BT-5071-Procedure DISPLAY #{name|BT-5071}: #value ($value); // Country Subdivision
			WITH BT-5141-Procedure DISPLAY #{name|BT-5141}: #value; // Country
			WITH BT-727-Procedure DISPLAY #value; // Restrictions on the place of performance
			WITH ND-ProcedurePlacePerformance[BT-728-Procedure is present] DISPLAY #{name|BT-728}: ${preferred-language-text(BT-728-Procedure)}; // Additional information
		4 WITH ND-ProcedureProcurementScope[BT-01-notice is present] DISPLAY #{auxiliary|text|general-information}; // 2.1.4 General information
			WITH ND-ProcedureProcurementScope[BT-300-Procedure is present] DISPLAY #{name|BT-300}: ${BT-300-Procedure}; // Additional information
			WITH ND-ProcedureProcurementScope DISPLAY #{auxiliary|text|legal-basis}:; // Legal basis
			WITH BT-01-notice DISPLAY #{BT-01-notice}; // Procedure Legal Basis
			WITH BT-01(c)-Procedure DISPLAY ${BT-01(c)-Procedure} - ${BT-01(d)-Procedure}; // Procedure Legal Basis (ID) - Procedure Legal Basis (Description)
			WITH BT-01(c)-Procedure DISPLAY ${BT-01(c)-Procedure} - ${BT-01(d)-Procedure}; // Procedure Legal Basis (ID) - Procedure Legal Basis (Description)
8 WITH ND-Root DISPLAY #{auxiliary|text|organisations}; // 8. Organisations
	1 WITH ND-Organization DISPLAY ${OPT-200-Organization-Company}; // 8.1 Organisation Technical Identifier
		WITH ND-Organization DISPLAY #{field|name|BT-500-Organization-Company}: ${BT-500-Organization-Company}; // Organisation Name
		WITH BT-165-Organization-Company DISPLAY #{business-term|name|BT-165}: ${BT-165-Organization-Company}; // Size of the economic operator
		WITH BT-633-Organization[BT-633-Organization == TRUE] DISPLAY #{business-term|name|BT-633}; // The organisation is a natural person.
		WITH BT-501-Organization-Company DISPLAY #{name|BT-501}: $value; // Organization Identifier
		WITH BT-16-Organization-Company DISPLAY #{name|BT-16}: $value; // Organization Part Name
		WITH BT-510(a)-Organization-Company DISPLAY #{name|BT-510}: ${BT-510(a)-Organization-Company} ${BT-510(b)-Organization-Company} ${BT-510(c)-Organization-Company}; // Postal address
		WITH BT-513-Organization-Company DISPLAY #{name|BT-513}: $value; // Organization City
		WITH BT-512-Organization-Company DISPLAY #{name|BT-512}: $value; // Organization Post Code
		WITH BT-507-Organization-Company DISPLAY #{name|BT-507}: #value ($value); // Organization Country Subdivision
		WITH BT-514-Organization-Company DISPLAY #{name|BT-514}: #value; // Organization Country
		WITH BT-502-Organization-Company DISPLAY #{name|BT-502}: $value; // Organization Contact Point
		WITH BT-506-Organization-Company DISPLAY #{name|BT-506}: $value; // Organization Contact Email Address
		WITH BT-503-Organization-Company DISPLAY #{name|BT-503}: $value; // Organization Contact Telephone Number
		WITH BT-739-Organization-Company DISPLAY #{name|BT-739}: $value; // Organization Contact Fax
		WITH BT-505-Organization-Company DISPLAY #{name|BT-505}: $value; // Organization Internet Address
		WITH BT-509-Organization-Company DISPLAY #{name|BT-509}: $value; // Organization eDelivery Gateway
		WITH OPT-200-Organization-Company[some text:$bpurl in (for text:$orgid in OPT-200-Organization-Company return BT-508-Procedure-Buyer[OPT-300-Procedure-Buyer == $orgid]) satisfies $bpurl != ''] DISPLAY #{name|BT-508}: ${for text:$orgid1 in OPT-200-Organization-Company return BT-508-Procedure-Buyer[OPT-300-Procedure-Buyer == $orgid1]}; // Buyer Profile URL
		0 WITH ND-Touchpoint DISPLAY #{auxiliary|text|other-contact-point}:; // TouchPoint / Other contact points
			WITH ND-Touchpoint DISPLAY #{field|name|BT-500-Organization-TouchPoint}: ${BT-500-Organization-TouchPoint}; // Buyer Touchpoint Name
			WITH BT-16-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Part Name
			WITH BT-510(a)-Organization-TouchPoint DISPLAY #{name}: ${BT-510(a)-Organization-TouchPoint} ${BT-510(b)-Organization-TouchPoint} ${BT-510(c)-Organization-TouchPoint}; // Touchpoint Postal Address
			WITH BT-513-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint City
			WITH BT-512-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Post Code
			WITH BT-507-Organization-TouchPoint DISPLAY #{name}: #value ($value); // Touchpoint Country Subdivision
			WITH BT-514-Organization-TouchPoint DISPLAY #{name|BT-514}: #value; // Touchpoint Country
			WITH BT-502-Organization-TouchPoint DISPLAY #{name}: $value; // Touchpoint Contact Point
			WITH BT-506-Organization-TouchPoint[OPT-200-Organization-Company == OPT-300-Procedure-Buyer]  DISPLAY #{name}: $value; // Touchpoint Contact Email Address
			WITH BT-503-Organization-TouchPoint[OPT-200-Organization-Company == OPT-300-Procedure-Buyer]  DISPLAY #{name}: $value; // Touchpoint Contact Telephone Number
			WITH BT-739-Organization-TouchPoint[OPT-200-Organization-Company == OPT-300-Procedure-Buyer]  DISPLAY #{name|BT-739}: $value; // Touchpoint Contact Fax
			WITH BT-505-Organization-TouchPoint[OPT-200-Organization-Company == OPT-300-Procedure-Buyer]  DISPLAY #{name|BT-505}: $value; // Touchpoint Internet Address
			WITH BT-509-Organization-TouchPoint[OPT-200-Organization-Company == OPT-300-Procedure-Buyer]  DISPLAY #{name|BT-509}: $value; // Touchpoint eDelivery Gateway
		0 WITH ND-Organization DISPLAY #{auxiliary|text|roles}:; // Roles of this organisation
			0 WITH OPT-200-Organization-Company[count(for text:$orgid in OPT-200-Organization-Company return OPT-300-Procedure-Buyer[OPT-300-Procedure-Buyer == $orgid])>0] DISPLAY #{auxiliary|text|buyer}; // This org is a Buyer
				WITH OPP-050-Organization[OPP-050-Organization == TRUE] DISPLAY #{name|OPP-050}; // Leader of the group
				WITH OPP-052-Organization[OPP-052-Organization == TRUE] DISPLAY #{name|OPP-052}; // CPB Acquiring
				WITH OPP-051-Organization[OPP-051-Organization == TRUE] DISPLAY #{name|OPP-051}; // CPB Awarding
			WITH OPT-200-Organization-Company[(some text:$esender in (for text:$orgid in OPT-200-Organization-Company, text:$servprovtype in OPT-030-Procedure-SProvider[OPT-300-Procedure-SProvider == $orgid] return $servprovtype) satisfies $esender == 'serv-prov') or (some text:$esender1 in (for text:$tpoid in OPT-201-Organization-TouchPoint, text:$servprovtype1 in OPT-030-Procedure-SProvider[OPT-300-Procedure-SProvider == $tpoid] return $servprovtype1) satisfies $esender1 == 'serv-prov')] DISPLAY #{auxiliary|text|organisation-providing-procurement-service}; // This org is a Service Provider
			WITH OPT-200-Organization-Company[(some text:$esender in (for text:$orgid in OPT-200-Organization-Company, text:$servprovtype in OPT-030-Procedure-SProvider[OPT-300-Procedure-SProvider == $orgid] return $servprovtype) satisfies $esender == 'ted-esen') or (some text:$esender1 in (for text:$tpoid in OPT-201-Organization-TouchPoint, text:$servprovtype1 in OPT-030-Procedure-SProvider[OPT-300-Procedure-SProvider == $tpoid] return $servprovtype1) satisfies $esender1 == 'ted-esen')] DISPLAY #{auxiliary|text|organisation-esender}; // This org is an eSender
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-AddInfo) or (OPT-201-Organization-TouchPoint == OPT-301-Part-AddInfo)] DISPLAY #{auxiliary|text|organisation-providing-info-procedure}; // Additional Information Providing Organisation (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-DocProvider) or (OPT-201-Organization-TouchPoint == OPT-301-Part-DocProvider)] DISPLAY #{auxiliary|text|organisation-providing-docs}; // Documents provider organisation (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-TenderReceipt) or (OPT-201-Organization-TouchPoint == OPT-301-Part-TenderReceipt)] DISPLAY #{auxiliary|text|organisation-tender-recipient}; // Organisation receiving requests to participate/Tender Recipient Organisation (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-TenderEval) or (OPT-201-Organization-TouchPoint == OPT-301-Part-TenderEval)] DISPLAY #{auxiliary|text|organisation-processing-tenders}; // Organisation processing requests to participate/Tender Evaluation Organisation (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-ReviewOrg) or (OPT-201-Organization-TouchPoint == OPT-301-Part-ReviewOrg)] DISPLAY #{auxiliary|text|organisation-review}; // Review organisation (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-ReviewInfo) or (OPT-201-Organization-TouchPoint == OPT-301-Part-ReviewInfo)] DISPLAY #{auxiliary|text|organisation-providing-info-review}; // Organisation providing information on the appeal procedures (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-Mediator) or (OPT-201-Organization-TouchPoint == OPT-301-Part-Mediator)] DISPLAY #{auxiliary|text|organisation-mediation}; // Mediation organisation (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-FiscalLegis) or (OPT-201-Organization-TouchPoint == OPT-301-Part-FiscalLegis)] DISPLAY #{auxiliary|text|organisation-providing-info-taxes}; // Tax legislation information provider (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-EnvironLegis) or (OPT-201-Organization-TouchPoint == OPT-301-Part-EnvironLegis)] DISPLAY #{auxiliary|text|organisation-providing-info-environment}; // Environment legislation information provider (PART)
			WITH OPT-200-Organization-Company[(OPT-200-Organization-Company == OPT-301-Part-EmployLegis) or (OPT-201-Organization-TouchPoint == OPT-301-Part-EmployLegis)] DISPLAY #{auxiliary|text|organisation-providing-info-environment}; // Employment legislation information provider (PART)
			0 WITH OPT-200-Organization-Company[OPT-302-Organization != ''], text:$uboidvar=(for text:$orgid in OPT-200-Organization-Company, text:$uboid in OPT-302-Organization[OPT-200-Organization-Company == $orgid] return $uboid)[at 1] DISPLAY #{auxiliary|text|beneficial-owner} ${$uboidvar}; // Beneficial Owner
				WITH OPT-200-Organization-Company[some text:$uboname in (BT-500-UBO[OPT-202-UBO == $uboidvar]) satisfies $uboname != ''] DISPLAY #{field|name|BT-500-UBO}: ${concat(OPT-160-UBO[OPT-202-UBO == $uboidvar], ' ', BT-500-UBO[OPT-202-UBO == $uboidvar])}; // Beneficial Owner Name
				WITH OPT-200-Organization-Company[some text:$ubonationality in (BT-706-UBO[OPT-202-UBO == $uboidvar]) satisfies $ubonationality != ''] DISPLAY #{business-term|name|BT-706}: #{${concat('code|name|country.', BT-706-UBO[OPT-202-UBO == $uboidvar])}}; // Beneficial Owner Nationality
				WITH OPT-200-Organization-Company[some text:$ubostreetname in (BT-510(a)-UBO[OPT-202-UBO == $uboidvar]) satisfies $ubostreetname != ''] DISPLAY #{business-term|name|BT-510}: ${concat(BT-510(a)-UBO[OPT-202-UBO == $uboidvar], ' ', BT-510(b)-UBO[OPT-202-UBO == $uboidvar], ' ', BT-510(c)-UBO[OPT-202-UBO == $uboidvar])}; // Beneficial Owner Postal Address
				WITH OPT-200-Organization-Company[some text:$ubocity in (BT-513-UBO[OPT-202-UBO == $uboidvar]) satisfies $ubocity != ''] DISPLAY #{field|name|BT-513-UBO}: ${BT-513-UBO[OPT-202-UBO == $uboidvar]}; // Beneficial Owner City
				WITH OPT-200-Organization-Company[some text:$ubopostcode in (BT-512-UBO[OPT-202-UBO == $uboidvar]) satisfies $ubopostcode != ''] DISPLAY #{field|name|BT-512-UBO}: ${BT-512-UBO[OPT-202-UBO == $uboidvar]}; // Beneficial Owner Post Code
				WITH OPT-200-Organization-Company[some text:$obonuts in (BT-507-UBO[OPT-202-UBO == $uboidvar]) satisfies $obonuts != ''] DISPLAY #{field|name|BT-507-UBO}: ${BT-507-UBO[OPT-202-UBO == $uboidvar]}; // Beneficial Owner Country Subdivision
				WITH OPT-200-Organization-Company[some text:$obocountry in (BT-514-UBO[OPT-202-UBO == $uboidvar]) satisfies $obocountry != ''] DISPLAY #{field|name|BT-514-UBO}: #{${concat('code|name|country.', BT-514-UBO[OPT-202-UBO == $uboidvar])}}; // Beneficial Owner Country
				WITH OPT-200-Organization-Company[some text:$obocountry in (BT-506-UBO[OPT-202-UBO == $uboidvar]) satisfies $obocountry != ''] DISPLAY #{field|name|BT-506-UBO}: ${BT-506-UBO[OPT-202-UBO == $uboidvar]}; // Beneficial Owner Contact Email Address
				WITH OPT-200-Organization-Company[some text:$obocountry in (BT-503-UBO[OPT-202-UBO == $uboidvar]) satisfies $obocountry != ''] DISPLAY #{field|name|BT-503-UBO}: ${BT-503-UBO[OPT-202-UBO == $uboidvar]}; // Beneficial Owner Telephone Number
				WITH OPT-200-Organization-Company[some text:$obocountry in (BT-739-UBO[OPT-202-UBO == $uboidvar]) satisfies $obocountry != ''] DISPLAY #{field|name|BT-739-UBO}: ${BT-739-UBO[OPT-202-UBO == $uboidvar]}; // Beneficial Owner Fax
			WITH OPT-200-Organization-Company[some text:$lotswon in (for text:$orgid in OPT-200-Organization-Company, text:$tpaid in OPT-210-Tenderer[OPT-300-Tenderer == $orgid], text:$tenderid in OPT-321-Tender[OPT-310-Tender == $tpaid], text:$contractid in OPT-315-LotResult[BT-3202-Contract == $tenderid], text:$lrid in OPT-322-LotResult[OPT-320-LotResult[OPT-315-LotResult == $contractid] == $tenderid], text:$lotid in BT-13713-LotResult[OPT-322-LotResult == $lrid] return $lotid ) satisfies $lotswon != ''] DISPLAY #{auxiliary|text|winner-lots}: ${distinct-values(for text:$orgid1 in OPT-200-Organization-Company, text:$tpaid1 in OPT-210-Tenderer[OPT-300-Tenderer == $orgid1], text:$tenderid1 in OPT-321-Tender[OPT-310-Tender == $tpaid1], text:$contractid1 in OPT-315-LotResult[BT-3202-Contract == $tenderid1], text:$lotresultid1 in OPT-322-LotResult[OPT-320-LotResult[OPT-315-LotResult == $contractid1] == $tenderid1], text:$lotid1 in BT-13713-LotResult[OPT-322-LotResult == $lotresultid1] return $lotid1 )}; // Winner of these Lots 
			WITH OPT-200-Organization-Company[some text:$lotswon in (for text:$orgid in OPT-200-Organization-Company[BT-746-Organization == TRUE], text:$tpaid in OPT-210-Tenderer[OPT-300-Tenderer == $orgid], text:$tenderid in OPT-321-Tender[OPT-310-Tender == $tpaid], text:$contractid in OPT-315-LotResult[BT-3202-Contract == $tenderid], text:$lotresultid in OPT-322-LotResult[OPT-320-LotResult[OPT-315-LotResult == $contractid] == $tenderid], text:$lotid in BT-13713-LotResult[OPT-322-LotResult == $lotresultid] return $lotid ) satisfies $lotswon != ''] DISPLAY #{business-term|name|BT-746}; // The winner is listed on a regulated market
10 WITH ND-Root[BT-758-notice is present] DISPLAY #{auxiliary|text|change}; // 10. Change
	WITH BT-758-notice DISPLAY #{field|name|BT-758-notice}: ${BT-758-notice}; // Change Notice Version Identifier
	WITH BT-140-notice DISPLAY #{name|BT-140}: #{BT-140-notice}; // Change Reason Code
	WITH BT-762-notice DISPLAY #{field|name|BT-762-notice}: ${BT-762-notice}; // Change Reason Description
	1 WITH ND-Change DISPLAY #{auxiliary|text|change}; // 10.1 Change
		WITH BT-13716-notice DISPLAY #{name|BT-13716}: ${BT-13716-notice}; // Change Previous Section Identifier
		WITH BT-141(a)-notice DISPLAY #{field|name|BT-141(a)-notice}: ${BT-141(a)-notice}; // Change Description
		WITH BT-719-notice DISPLAY #{business-term|name|BT-718}: ${BT-719-notice}; // Change Procurement Documents / Change Procurement Documents Date
11 WITH ND-Root DISPLAY #{auxiliary|text|notice-information}; // 11. Notice information
	1 WITH ND-Root DISPLAY #{auxiliary|text|notice-information}; // 11.1 Notice information
		WITH BT-701-notice DISPLAY #{name|BT-701}: ${BT-701-notice} - ${BT-757-notice}; // Notice identifier / version
		WITH BT-03-notice DISPLAY #{name|BT-03}: #{BT-03-notice}; // Form type
		WITH BT-02-notice DISPLAY #{name|BT-02}: #{BT-02-notice}; // Notice type
		WITH BT-05(a)-notice DISPLAY #{name|BT-05}: ${BT-05(a)-notice} ${BT-05(b)-notice}; // Notice dispatch date and time
		WITH BT-702(a)-notice DISPLAY #{name|BT-702}: #{BT-702(a)-notice} #{BT-702(b)-notice}; // Languages in which this notice is officially available
	2 WITH ND-Root DISPLAY #{auxiliary|text|publication-information}; // 11.2 Publication information
		WITH OPP-010-notice DISPLAY #{name|OPP-010}: ${OPP-010-notice}; // Notice publication number
		WITH OPP-011-notice DISPLAY #{name|OPP-011}: ${OPP-011-notice}; // OJ S issue number
		WITH OPP-012-notice DISPLAY #{name|OPP-012}: ${OPP-012-notice}; // Publication date
